{
  "name": "nestjs-docs",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run docs",
    "start": "ng serve",
    "start:watch": "ng serve --watch",
    "prebuild": "npm run docs",
    "build": "ng build --delete-output-path=false",
    "build:watch": "concurrently \"nodemon --config nodemon.json\" \"npm run start:watch\"",
    "prebuild:prod": "npm run api:fetch && npm run docs",
    "build:prod": "ng build --configuration production --aot --delete-output-path=false",
    "test": "ng test",
    "lint": "eslint \"**/*.{ts,tsx}\" ",
    "docs": "npm run api:compile -- --if-sources && npm run docs-only && npm run llms",
    "llms": "ts-node -P tools/tsconfig.json tools/generate-llms-txt.ts",
    "docs-only": "ts-node -P tools/tsconfig.json tools/dgeni-cli.ts tools/transforms/nestjs-package/index",
    "api": "npm run api:fetch && npm run api:compile",
    "api:fetch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/api/fetch-sources.ts",
    "api:compile": "ts-node -P tools/tsconfig.json tools/api/compiler/index.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,json}": []
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.1",
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "prismjs": "1.30.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.1",
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-angular": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/prismjs": "1.26.6",
    "angular-eslint": "22.5.0",
    "canonical-path": "0.0.2",
    "concurrently": "10.0.5",
    "dgeni": "0.4.14",
    "dgeni-packages": "0.30.0",
    "eslint": "10.11.0",
    "hast-util-has-property": "1.0.4",
    "hast-util-is-element": "1.1.0",
    "hast-util-to-string": "1.0.4",
    "husky": "9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "17.6.0",
    "marked": "18.0.14",
    "nodemon": "3.1.14",
    "rehype-slug": "4.0.1",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "unist-util-visit": "2.0.3",
    "unist-util-visit-parents": "3.1.1",
    "vitest": "5.0.3",
    "yargs": "17.7.3",
    "zone.js": "0.16.3"
  },
  "engines": {
    "node": ">=24"
  }
}
