{
  "name": "nestjs-docs",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run docs",
    "start": "ng serve",
    "start:watch": "ng serve --watch",
    "prebuild": "npm run clean-dist && npm run docs",
    "build": "ng build --delete-output-path=false",
    "postbuild": "npm run flatten-prerendered",
    "build:watch": "concurrently \"nodemon --config nodemon.json\" \"npm run start:watch\"",
    "prebuild:prod": "npm run clean-dist && npm run docs",
    "build:prod": "ng build --configuration production --aot --delete-output-path=false",
    "postbuild:prod": "npm run flatten-prerendered",
    "clean-dist": "git clean -fdqX dist",
    "flatten-prerendered": "ts-node -P tools/tsconfig.json tools/flatten-prerendered-pages.ts",
    "test": "ng test",
    "lint": "eslint \"**/*.{ts,tsx}\" ",
    "docs": "npm run docs-only && npm run llms",
    "llms": "ts-node -P tools/tsconfig.json tools/generate-llms-txt.ts",
    "docs-only": "ts-node -P tools/tsconfig.json tools/dgeni-cli.ts tools/transforms/nestjs-package/index",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,json}": []
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.5",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.5",
    "@angular/platform-server": "22.2.5",
    "@angular/router": "22.2.5",
    "@angular/ssr": "22.2.6",
    "prismjs": "1.30.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.6",
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-angular": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/prismjs": "1.26.6",
    "angular-eslint": "22.6.0",
    "concurrently": "10.0.7",
    "dgeni": "0.4.14",
    "dgeni-packages": "0.30.0",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "17.6.0",
    "marked": "18.1.3",
    "nodemon": "3.1.14",
    "rimraf": "6.1.4",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yargs": "17.7.3",
    "zone.js": "0.16.3"
  }
}
