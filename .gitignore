# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output. Everything in dist/ except the archived versions below is
# build output, and `npm run build` clears it first (`npm run clean-dist`):
# the build keeps dist/ to spare the archives (--delete-output-path=false), and
# Netlify carries the previous build's files over, so a page or file that is
# gone from the docs would otherwise keep being served.
dist/*
!/dist/v4
!/dist/v5
!/dist/v6
!/dist/v7
!/dist/v8
!/dist/v9
!/dist/v10
!/dist/v11

/tmp
/out-tsc

# dependencies
/node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
.vscode
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
*.code-workspace
/.vscode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
testem.log
/typings
.angular
# e2e
/e2e/*.js
/e2e/*.map

# System Files
.DS_Store
Thumbs.db

# Mock API
/api/node_modules

# compiled templates
src/app/homepage/pages/**/*.html

# generated by tools/generate-llms-txt.ts during `npm run docs`
src/llms.txt
src/llms-full.txt
src/sitemap.xml
src/md/
