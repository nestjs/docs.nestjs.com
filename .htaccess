RewriteEngine On
RewriteBase /

RewriteCond %{HTTPS} off
RewriteRule (.*) https://%{HTTP_HOST}/$1 [R=301,L]

# Markdown copies of chapters that moved to other URLs (see llms.txt). The
# chapters themselves redirect in the Angular routes.
RewriteRule ^application/http-module\.md$ /application/http-client.md [R=301,L]
RewriteRule ^recipes/mikroorm\.md$ /data/mikroorm.md [R=301,L]
RewriteRule ^recipes/prisma\.md$ /data/prisma.md [R=301,L]
RewriteRule ^techniques/caching\.md$ /data/caching.md [R=301,L]
RewriteRule ^techniques/compression\.md$ /http/compression.md [R=301,L]
RewriteRule ^techniques/configuration\.md$ /application/configuration.md [R=301,L]
RewriteRule ^techniques/cookies\.md$ /http/cookies.md [R=301,L]
RewriteRule ^techniques/database\.md$ /data/overview.md [R=301,L]
RewriteRule ^techniques/events\.md$ /application/events.md [R=301,L]
RewriteRule ^techniques/file-upload\.md$ /http/file-upload.md [R=301,L]
RewriteRule ^techniques/http-module\.md$ /application/http-client.md [R=301,L]
RewriteRule ^techniques/logger\.md$ /application/logger.md [R=301,L]
RewriteRule ^techniques/mongodb\.md$ /data/mongodb.md [R=301,L]
RewriteRule ^techniques/mvc\.md$ /http/mvc.md [R=301,L]
RewriteRule ^techniques/performance\.md$ /http/performance.md [R=301,L]
RewriteRule ^techniques/queues\.md$ /application/queues.md [R=301,L]
RewriteRule ^techniques/serialization\.md$ /application/serialization.md [R=301,L]
RewriteRule ^techniques/server-sent-events\.md$ /http/server-sent-events.md [R=301,L]
RewriteRule ^techniques/session\.md$ /http/session.md [R=301,L]
RewriteRule ^techniques/task-scheduling\.md$ /application/task-scheduling.md [R=301,L]
RewriteRule ^techniques/validation\.md$ /application/validation.md [R=301,L]
RewriteRule ^techniques/versioning\.md$ /http/versioning.md [R=301,L]

RewriteCond %{REQUEST_FILENAME} -s [OR]
RewriteCond %{REQUEST_FILENAME} -l [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.*$ - [NC,L]

# Archived documentation versions are static builds under /vN. Existing files
# are already served by the rule above; anything else inside an archive is a
# client side route and must resolve to that archive's index.html rather than
# the current docs.
RewriteRule ^(v4|v5|v6|v7|v8|v9|v10|v11)/ /$1/index.html [NC,L]

RewriteRule ^(.*) /index.html [NC,L]